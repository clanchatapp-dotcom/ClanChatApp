[NOTE] This file contains placeholder values. Do NOT commit real secret keys into source control.

# The Supabase project URL (example):
SUPABASE_URL="https://<your-supabase>.supabase.co"

# The public anon key (used by frontend). Safe to embed in builds, not in server secrets:
SUPABASE_ANON_KEY="<anon-key>"

# IMPORTANT: service_role key — MUST be kept secret and injected into backend env:
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Optional: storage bucket name used by the app
SUPABASE_BUCKET="ClanChatApp"
